{
 "meta": {
  "preset": "slider_control_board",
  "session": "demo",
  "round": 1,
  "arch": "sd15",
  "sliders": {
   "a": "rotate middle_block.1",
   "b": "scale input_blocks.4.0",
   "c": "multiply output_blocks.9.*",
   "d": "t_end of the rotate/scale window"
  }
 },
 "groups": [
  {
   "id": "controls",
   "title": "🎚 CONTROL BOARD · move a-d, press Run (Ctrl+S hands the values to the agent)",
   "color": "#a1309b"
  },
  {
   "id": "base",
   "title": "Base · loaders and prompt",
   "color": "#444444"
  },
  {
   "id": "bends",
   "title": "Bends · one JSON template, clamped to the measured safe ranges",
   "color": "#3f5159"
  },
  {
   "id": "out",
   "title": "Output · baseline vs bent (same seed)",
   "color": "#335533"
  }
 ],
 "nodes": {
  "sA": {
   "class_type": "PrimitiveFloat",
   "group": "controls",
   "title": "🎚 a · rotate ° at mid (safe 0-180, 0 = off)",
   "inputs": {
    "value": 90.0
   }
  },
  "sB": {
   "class_type": "PrimitiveFloat",
   "group": "controls",
   "title": "🎚 b · scale at in.mid (safe 0.7-1.3, 1 = off)",
   "inputs": {
    "value": 1.0
   }
  },
  "sC": {
   "class_type": "PrimitiveFloat",
   "group": "controls",
   "title": "🎚 c · gain at out.hi (safe 0.6-1.6, 1 = off)",
   "inputs": {
    "value": 1.0
   }
  },
  "sD": {
   "class_type": "PrimitiveFloat",
   "group": "controls",
   "title": "🎚 d · t where the a/b window ends (0.7 = structure only, 0 = every step)",
   "inputs": {
    "value": 0.7
   }
  },
  "sSeed": {
   "class_type": "PrimitiveInt",
   "group": "controls",
   "title": "🎚 seed",
   "inputs": {
    "value": 7
   }
  },
  "ckpt": {
   "class_type": "CheckpointLoaderSimple",
   "group": "base",
   "inputs": {
    "ckpt_name": "LCM_Dreamshaper_v7_4k.safetensors"
   }
  },
  "msd": {
   "class_type": "ModelSamplingDiscrete",
   "group": "base",
   "inputs": {
    "model": [
     "ckpt",
     0
    ],
    "sampling": "lcm",
    "zsnr": false
   }
  },
  "clip": {
   "class_type": "CLIPLoader",
   "group": "base",
   "inputs": {
    "clip_name": "model_v1-4.safetensors",
    "type": "stable_diffusion"
   }
  },
  "vae": {
   "class_type": "VAELoader",
   "group": "base",
   "inputs": {
    "vae_name": "vae-ft-mse-840000-ema-pruned.safetensors"
   }
  },
  "pos": {
   "class_type": "CLIPTextEncode",
   "group": "base",
   "title": "Prompt",
   "inputs": {
    "clip": [
     "clip",
     0
    ],
    "text": "a lighthouse on a sea cliff at dusk, oil painting"
   }
  },
  "neg": {
   "class_type": "CLIPTextEncode",
   "group": "base",
   "title": "Negative",
   "inputs": {
    "clip": [
     "clip",
     0
    ],
    "text": "lowres, blurry, jpeg artifacts, watermark, text"
   }
  },
  "lat": {
   "class_type": "EmptyLatentImage",
   "group": "base",
   "inputs": {
    "width": 512,
    "height": 512,
    "batch_size": 1
   }
  },
  "bend": {
   "class_type": "ApplyBendsFromJSON",
   "group": "bends",
   "title": "Bends (template; a-d come from the sliders)",
